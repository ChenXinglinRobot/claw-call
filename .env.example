# 火山引擎豆包 API 配置
DOUBAO_APP_ID=your_app_id_here
DOUBAO_ACCESS_KEY=your_access_key_here
DOUBAO_RESOURCE_ID=volc.speech.dialog #固定值，详见https://www.volcengine.com/docs/6561/1594356?lang=zh 的X-Api-App-Key这里的注释必须空一格
DOUBAO_APP_KEY=your_app_key_here #固定值详见https://www.volcengine.com/docs/6561/1594356?lang=zh 的X-Api-Resource-Id这里的注释必须空一格
DOUBAO_WSS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# 飞书应用配置
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# OpenClaw Gateway 配置（用于记忆结算通知）
OPENCLAW_TOKEN=your_openclaw_gateway_token_here
OPENCLAW_GATEWAY_URL=http://127.0.0.1:12392/v1/chat/completions
OPENCLAW_AGENT_ID=main

# 记忆文件存储目录
MEMORY_DIR=memory
